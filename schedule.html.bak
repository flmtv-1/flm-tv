  {t:"03:19",n:"The Lord Of The Rings The Two Towers 2002 EXTENDED 2160p 4K BluRay x265 10bit AAC5 1 [YTS MX]",d:14132,cat:""},
  {t:"07:15",n:"Snail logo1 Z",d:15,cat:""},
  {t:"07:15",n:"Sesame Street S40E24 Abby\'s Tricycle ia",d:3366,cat:""},
  {t:"08:11",n:"Sesame Street ",d:1556,cat:""},
  {t:"08:37",n:"Ready Jet Go ",d:1591,cat:""},
  {t:"09:04",n:"Rolie Polie Olie ",d:1446,cat:""},
  {t:"09:28",n:"Super Why",d:1620,cat:""}
];

// ── TIME UTILITIES ────────────────────────────────────────────────────
function nowMin() {
  const d = new Date();
  return d.getHours()*60 + d.getMinutes() + d.getSeconds()/60;
}

function toMin(t) {
  const [h,m] = t.split(':').map(Number);
  return h*60+m;
}

// Simple straight clock comparison - no phases, no jumping
function getStatus(show) {
  const now = nowMin();
  const start = toMin(show.t);
  const end = start + show.d/60;
  // Handle overnight shows that cross midnight
  const nowAdj = now < 6*60 ? now + 1440 : now;
  const startAdj = start < 6*60 ? start + 1440 : start;
  const endAdj = startAdj + show.d/60;
  if (nowAdj >= startAdj && nowAdj < endAdj) return 'live';
  if (nowAdj >= endAdj) return 'aired';
  return 'upcoming';
}

function getProgress(show) {
  const now = nowMin();
  const nowAdj = now < 6*60 ? now + 1440 : now;
  const start = toMin(show.t);
  const startAdj = start < 6*60 ? start + 1440 : start;
  const endAdj = startAdj + show.d/60;
  return Math.min(100, ((nowAdj - startAdj)/(endAdj - startAdj))*100);
}

function fmt12(t) {
  let [h,m] = t.split(':').map(Number);
  const ap = h>=12?'PM':'AM';
  h = h%12||12;
  return `${h}:${String(m).padStart(2,'0')} ${ap}`;
}

function fmtEnd(t, durSec) {
  const [h,m] = t.split(':').map(Number);
  const total = h*60+m + durSec/60;
  const eh = Math.floor(total/60)%24, em = Math.round(total%60);
  const ap = eh>=12?'PM':'AM';
  return `${eh%12||12}:${String(em).padStart(2,'0')} ${ap}`;
}

function fmtDur(s) {
  if (s<60) return s+'s';
  const m=Math.floor(s/60), h=Math.floor(m/60);
  if (h>0) return h+'h '+(m%60>0?m%60+'m':'');
  return m+' min';
}

// ── RENDER ────────────────────────────────────────────────────────────
function renderSchedule() {
  const wrap = document.getElementById('scheduleWrap');
  wrap.innerHTML = '';
  const date = new Date().toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'}).toUpperCase();
  wrap.insertAdjacentHTML('beforeend',
    `<div class="time-block-header"><div class="time-block-label">${date}</div><div class="time-block-line"></div></div>`
  );

  // Find the SINGLE live show (first match only) — prevents double highlight bug
  const liveShow = TODAY_SCHEDULE.find(s => getStatus(s) === 'live') || null;

  const airedItems = TODAY_SCHEDULE.filter(s => getStatus(s)==='aired');
  const keepAired = new Set(airedItems.slice(-20).map(s=>s.t+s.n));

  let showCount=0, totalSec=0;
  TODAY_SCHEDULE.forEach(s => {
    if (s.cat!=='ad') { showCount++; totalSec+=s.d; }
  });
  document.getElementById('statTotal').textContent = showCount;
  document.getElementById('statHours').textContent = (totalSec/3600).toFixed(1);

  TODAY_SCHEDULE.forEach(s => {
    const status = getStatus(s);
    if (status==='aired' && !keepAired.has(s.t+s.n)) return;

    // Only the ONE designated live show gets highlighted — all others stay upcoming/aired
    const isLive = liveShow && s.t === liveShow.t && s.n === liveShow.n;
    const isAired = !isLive && status==='aired';
    const isAd = s.cat==='ad';
    const isMovie = s.cat==='movie';
    const isKids = s.cat==='kids';
    const isFlm = s.cat==='flm';

    const cardClass = [
      'show-card',
      isLive?'live-now':(isAired?'aired':'upcoming'),
      isAd?'ad-card':'',
      isFlm?'flm-card':''
    ].filter(Boolean).join(' ');

    const filterData = [
      s.cat==='show'||s.cat==='flm'?'shows':'',
      isMovie?'movies':'',
      isKids?'kids':'',
      isFlm?'flm':'',
      status==='upcoming'?'upcoming':''
    ].filter(Boolean).join(' ');

    const pct = isLive ? getProgress(s) : 0;
    const liveId = isLive ? 'id="live-now-card"' : '';

    wrap.insertAdjacentHTML('beforeend', `
      <div class="${cardClass}" ${liveId} data-filter="${filterData}" tabindex="0">
        <div class="show-time">
          <div class="show-time-start">${fmt12(s.t)}</div>
          <div class="show-time-end">${fmtEnd(s.t,s.d)}</div>
        </div>
        <div class="show-info">
          <div class="show-name">${s.n}${isMovie?'<span class="movie-badge">MOVIE</span>':''}</div>
          ${isLive?`<div class="live-badge"><span class="live-badge-dot"></span> ON AIR NOW</div>`:''}
          ${isFlm?`<div class="show-meta">★ FLM ORIGINAL</div>`:''}
          ${isKids?`<div class="show-meta">KIDS</div>`:''}
          ${isLive?`<a href="live.html" class="watch-now-btn">▶ Watch Now</a>`:''}
        </div>
        <div class="show-dur">${fmtDur(s.d)}</div>
        ${isLive?`<div class="progress-bar-wrap"><div class="progress-bar-fill" id="progressFill" style="width:${pct}%"></div></div>`:''}
      </div>`);
  });
}

// ── DOWNLOAD ──────────────────────────────────────────────────────────
function downloadSchedule() {
  const date = new Date().toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'});
  let txt = `FLM TV — CHANNEL 26.5 · LAS VEGAS · WORLDWIDE\nTODAY'S PROGRAMMING — ${date}\n${'─'.repeat(50)}\n\n`;
  TODAY_SCHEDULE.forEach(s => {
    if (s.cat==='ad') return;
    txt += `${fmt12(s.t).padEnd(12)} ${s.n}\n`;
  });
  const blob = new Blob([txt], {type:'text/plain'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `FLM-TV-Schedule-${new Date().toISOString().slice(0,10)}.txt`;
  a.click();
}

// ── OTHER FUNCTIONS ───────────────────────────────────────────────────
function jumpToNow() {
  const el = document.getElementById('live-now-card');
  if (!el) {  return; }
  el.scrollIntoView({behavior:'smooth',block:'center'});
  el.style.boxShadow='0 0 0 3px #00E676,0 0 40px rgba(0,230,118,0.35)';
  setTimeout(()=>{el.style.boxShadow='';},900);
}

function filterSchedule(cat, btn) {
  document.querySelectorAll('.ftab').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.show-card').forEach(card=>{
    const tags = card.dataset.filter||'';
    let show = false;
    if (cat==='all') show=true;
    else if (cat==='shows') show=tags.includes('shows')&&!tags.includes('movies');
    else if (cat==='movies') show=tags.includes('movies');
    else if (cat==='kids') show=tags.includes('kids');
    else if (cat==='flm') show=tags.includes('flm');
    else if (cat==='upcoming') show=tags.includes('upcoming');
    card.classList.toggle('hidden',!show);
  });
}

function updateClock() {
  const d=new Date();
  const h=d.getHours()%12||12, m=String(d.getMinutes()).padStart(2,'0'), s=String(d.getSeconds()).padStart(2,'0');
  const el=document.getElementById('clockDisplay');
  if(el) el.textContent=`${h}:${m}:${s} ${d.getHours()>=12?'PM':'AM'}`;
}

function updateProgress() {
  const fill=document.getElementById('progressFill');
  if(!fill) return;
  const live=TODAY_SCHEDULE.find(s=>getStatus(s)==='live');
  if(live) fill.style.width=getProgress(live)+'%';
}

document.getElementById('heroDate').textContent =
  new Date().toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'}).toUpperCase();
renderSchedule();
jumpToNow();
updateClock();
setInterval(updateClock,1000);
setInterval(updateProgress,10000);
setInterval(renderSchedule,60000);
</script>

<script>
(function(){
  var ua=navigator.userAgent||'';
  if(!/AFT|FireTV|Silk/i.test(ua))return;
  var vp=document.querySelector('meta[name="viewport"]');
  if(vp)vp.setAttribute('content','width=960,initial-scale=1.0,maximum-scale=1.0,user-scalable=no');
  var style=document.createElement('style');
  style.textContent=`.show-card:focus,.ftab:focus,.jump-btn:focus,.nav-logo:focus,a:focus{outline:4px solid #ffd700!important;box-shadow:0 0 20px rgba(255,215,0,0.5)!important;z-index:10;position:relative;}#live-now-card:focus{outline:4px solid #00E676!important;}`;
  document.head.appendChild(style);
  function getFocusable(){return Array.from(document.querySelectorAll('.show-card:not(.hidden),.ftab,.jump-btn,.nav-logo,a.live-pill')).filter(el=>el.offsetParent!==null);}
  function findBest(cur,all,dir){var cr=cur.getBoundingClientRect(),cx=cr.left+cr.width/2,cy=cr.top+cr.height/2;var cands=all.filter(el=>{if(el===cur)return false;var r=el.getBoundingClientRect(),ex=r.left+r.width/2,ey=r.top+r.height/2;if(dir==='right')return ex>cr.right-10;if(dir==='left')return ex<cr.left+10;if(dir==='down')return ey>cr.bottom-10;if(dir==='up')return ey<cr.top+10;});if(!cands.length)return null;var best=null,bs=Infinity;cands.forEach(el=>{var r=el.getBoundingClientRect(),dx=(r.left+r.width/2)-cx,dy=(r.top+r.height/2)-cy,p=(dir==='right'||dir==='left')?Math.abs(dx):Math.abs(dy),s=(dir==='right'||dir==='left')?Math.abs(dy):Math.abs(dx),score=p+s*0.3;if(score<bs){bs=score;best=el;}});return best;}
  document.addEventListener('keydown',function(e){var all=getFocusable();if(!all.length)return;var focused=document.activeElement,inList=all.indexOf(focused)>=0;if(!inList){if(['ArrowRight','ArrowDown','ArrowLeft','ArrowUp','Enter'].includes(e.key)){e.preventDefault();var lc=document.getElementById('live-now-card');if(lc){lc.focus();lc.scrollIntoView({block:'center'});}else{all[0].focus();}}return;}var dir={ArrowRight:'right',ArrowLeft:'left',ArrowDown:'down',ArrowUp:'up'}[e.key];if(dir){e.preventDefault();var next=findBest(focused,all,dir);if(next){next.focus();next.scrollIntoView({behavior:'smooth',block:'center'});}else if(dir==='up'){window.scrollTo({top:0,behavior:'smooth'});setTimeout(()=>{all[0].focus();},400);}}if(e.key==='Backspace'||e.key==='Escape'){e.preventDefault();window.location.href='home.html';}},true);
})();
</script>
</body>
</html>
