<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FLM TV — Today's Schedule</title>
<link rel="icon" type="image/png" href="assets/logos/favicons-3/favicon-96x96.png">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@300;400;500;600;700&family=Barlow+Condensed:wght@300;400;600;700&family=Share+Tech+Mono&display=swap');
:root{--gold:#C9A84C;--gold-light:#E8C97A;--gold-dim:#7A6330;--red:#C0272D;--red-bright:#E8333A;--black:#070709;--dark:#0E0E13;--dark2:#14141A;--dark3:#1C1C24;--dark4:#26262F;--text:#F0EDE8;--text-dim:#888898;--text-muted:#444450;--live-green:#00E676;--ad-blue:#4A9EFF;}
*{margin:0;padding:0;box-sizing:border-box;}html{scroll-behavior:smooth;}
body{background:var(--black);color:var(--text);font-family:'Barlow',sans-serif;min-height:100vh;overflow-x:hidden;}
body::after{content:'';position:fixed;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(0,0,0,0.012) 3px,rgba(0,0,0,0.012) 4px);pointer-events:none;z-index:999;}
.topnav{position:sticky;top:0;z-index:200;display:flex;align-items:center;justify-content:space-between;padding:0 32px;height:60px;background:rgba(7,7,9,0.97);border-bottom:1px solid rgba(201,168,76,0.2);backdrop-filter:blur(12px);}
.nav-logo{font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:5px;color:var(--gold);text-decoration:none;}
.nav-logo span{color:var(--red);}
.nav-links{display:flex;gap:24px;list-style:none;}
.nav-links a{color:var(--text-dim);text-decoration:none;font-size:12px;font-weight:600;letter-spacing:2px;text-transform:uppercase;transition:color 0.2s;}
.nav-links a:hover,.nav-links a.active{color:var(--gold);}
.live-pill{display:flex;align-items:center;gap:7px;background:var(--red);color:#fff;text-decoration:none;font-family:'Barlow Condensed',sans-serif;font-size:12px;font-weight:700;letter-spacing:2px;padding:7px 16px;border-radius:2px;transition:background 0.2s;}
.live-pill:hover{background:var(--red-bright);}
.live-dot{width:7px;height:7px;border-radius:50%;background:#fff;animation:blink 1.2s infinite;}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0.2}}
.hero{position:relative;overflow:hidden;padding:48px 32px 36px;background:linear-gradient(180deg,rgba(192,39,45,0.07) 0%,transparent 100%);text-align:center;}
.hero-ghost{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-family:'Bebas Neue',sans-serif;font-size:180px;letter-spacing:16px;color:rgba(201,168,76,0.025);white-space:nowrap;pointer-events:none;user-select:none;}
.hero-eyebrow{display:inline-flex;align-items:center;gap:8px;font-family:'Share Tech Mono',monospace;font-size:11px;letter-spacing:3px;color:var(--gold-dim);border:1px solid rgba(201,168,76,0.18);padding:5px 14px;border-radius:2px;margin-bottom:18px;}
.hero-title{font-family:'Bebas Neue',sans-serif;font-size:68px;letter-spacing:6px;line-height:1;color:var(--text);margin-bottom:8px;}
.hero-title em{color:var(--gold);font-style:normal;}
.hero-date{font-family:'Barlow Condensed',sans-serif;font-size:17px;letter-spacing:4px;color:var(--text-dim);text-transform:uppercase;margin-bottom:28px;}
.hero-stats{display:flex;justify-content:center;gap:48px;}
.stat-num{font-family:'Bebas Neue',sans-serif;font-size:34px;letter-spacing:2px;color:var(--gold);line-height:1;}
.stat-label{font-size:10px;letter-spacing:2px;color:var(--text-muted);text-transform:uppercase;margin-top:3px;}
.jump-bar{display:flex;align-items:center;justify-content:center;gap:16px;padding:14px 32px;background:var(--dark2);border-top:1px solid rgba(201,168,76,0.1);border-bottom:1px solid rgba(201,168,76,0.1);}
.jump-btn{display:inline-flex;align-items:center;gap:8px;background:transparent;border:1px solid rgba(0,230,118,0.4);color:var(--live-green);font-family:'Barlow Condensed',sans-serif;font-size:13px;font-weight:700;letter-spacing:2px;padding:8px 20px;border-radius:2px;cursor:pointer;text-transform:uppercase;transition:all 0.2s;}
.jump-btn:hover{background:rgba(0,230,118,0.1);}
.clock-display{font-family:'Share Tech Mono',monospace;font-size:14px;color:var(--text-dim);letter-spacing:2px;}
.filter-bar{display:flex;gap:8px;padding:16px 32px;background:var(--dark);border-bottom:1px solid rgba(255,255,255,0.04);overflow-x:auto;}
.filter-bar::-webkit-scrollbar{display:none;}
.ftab{flex-shrink:0;background:transparent;border:1px solid var(--dark4);color:var(--text-dim);font-family:'Barlow Condensed',sans-serif;font-size:12px;font-weight:600;letter-spacing:1.5px;padding:6px 16px;border-radius:2px;cursor:pointer;text-transform:uppercase;transition:all 0.2s;}
.ftab:hover{border-color:var(--gold-dim);color:var(--gold);}
.ftab.active{background:var(--gold);border-color:var(--gold);color:#000;}
.schedule-wrap{max-width:860px;margin:0 auto;padding:28px 32px 80px;}
.time-block-header{display:flex;align-items:center;gap:14px;padding:24px 0 10px;}
.time-block-label{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:3px;color:var(--gold-dim);white-space:nowrap;}
.time-block-line{flex:1;height:1px;background:linear-gradient(90deg,rgba(201,168,76,0.2),transparent);}
.show-card{display:grid;grid-template-columns:90px 1fr auto;align-items:stretch;gap:0;margin-bottom:3px;border-radius:4px;overflow:hidden;transition:transform 0.15s;position:relative;}
.show-card:not(.live-now):hover{transform:translateX(3px);}
.show-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;z-index:1;}
.show-card.upcoming::before{background:var(--dark4);}
.show-card.live-now::before{background:var(--live-green);}
.show-card.ad-card::before{background:rgba(74,158,255,0.25);}
.show-card.flm-card::before{background:var(--gold-dim);}
.show-time{padding:13px 14px;background:var(--dark2);border-right:1px solid rgba(255,255,255,0.04);text-align:right;display:flex;flex-direction:column;justify-content:center;}
.show-time-start{font-family:'Share Tech Mono',monospace;font-size:12px;color:var(--text);letter-spacing:0.5px;}
.show-time-end{font-family:'Share Tech Mono',monospace;font-size:10px;color:var(--text-muted);margin-top:2px;}
.show-info{padding:13px 18px;background:var(--dark2);border-right:1px solid rgba(255,255,255,0.04);flex:1;}
.show-name{font-family:'Barlow Condensed',sans-serif;font-size:16px;font-weight:600;letter-spacing:0.5px;color:var(--text);line-height:1.2;}
.show-meta{font-size:11px;color:var(--text-muted);margin-top:3px;letter-spacing:0.5px;}
.show-dur{padding:13px 14px;background:var(--dark2);font-family:'Share Tech Mono',monospace;font-size:11px;color:var(--text-muted);white-space:nowrap;display:flex;align-items:center;}
.show-card.aired .show-time,.show-card.aired .show-info,.show-card.aired .show-dur{background:rgba(14,14,19,0.5);opacity:0.4;}
.show-card.live-now{box-shadow:0 0 0 2px var(--live-green),0 4px 28px rgba(0,230,118,0.12);}
.show-card.live-now .show-time{background:rgba(0,230,118,0.07);border-right-color:rgba(0,230,118,0.15);}
.show-card.live-now .show-info{background:rgba(0,230,118,0.05);border-right-color:rgba(0,230,118,0.1);}
.show-card.live-now .show-dur{background:rgba(0,230,118,0.04);}
.show-card.live-now .show-time-start{color:var(--live-green);}
.show-card.live-now .show-name{color:#fff;font-size:17px;}
.live-badge{display:inline-flex;align-items:center;gap:6px;background:var(--live-green);color:#000;font-family:'Barlow Condensed',sans-serif;font-size:10px;font-weight:700;letter-spacing:2px;padding:2px 8px;border-radius:2px;margin-top:6px;}
.live-badge-dot{width:5px;height:5px;border-radius:50%;background:#000;animation:blink 1s infinite;}
.watch-now-btn{display:inline-flex;align-items:center;gap:6px;margin-top:8px;background:var(--live-green);color:#000;font-weight:800;font-size:12px;letter-spacing:1px;padding:6px 16px;border-radius:4px;text-decoration:none;transition:all 0.2s;}
.watch-now-btn:hover{background:#fff;color:#000;}
.progress-bar-wrap{grid-column:1/-1;height:3px;background:rgba(0,230,118,0.1);}
.progress-bar-fill{height:100%;background:var(--live-green);transition:width 1s linear;}
.show-card.ad-card .show-time,.show-card.ad-card .show-info,.show-card.ad-card .show-dur{background:rgba(74,158,255,0.03);}
.show-card.ad-card .show-name{color:var(--ad-blue);font-size:13px;font-weight:500;}
.show-card.ad-card .show-time-start{color:var(--ad-blue);font-size:11px;}
.show-card.ad-card.aired{opacity:1;}
.show-card.flm-card .show-name{color:var(--gold);}
.show-card.flm-card .show-time,.show-card.flm-card .show-info,.show-card.flm-card .show-dur{background:rgba(201,168,76,0.03);}
.movie-badge{display:inline-block;font-family:'Barlow Condensed',sans-serif;font-size:9px;font-weight:700;letter-spacing:1.5px;color:var(--gold);border:1px solid rgba(201,168,76,0.3);padding:1px 6px;border-radius:2px;margin-left:8px;vertical-align:middle;}
.show-card.hidden{display:none!important;}
.schedule-footer{text-align:center;padding:40px 32px;border-top:1px solid rgba(201,168,76,0.1);color:var(--text-muted);font-size:12px;letter-spacing:1px;line-height:2;}
.schedule-footer a{color:var(--gold-dim);text-decoration:none;}
.schedule-footer a:hover{color:var(--gold);}
@media(max-width:640px){
  .topnav{padding:0 16px;}.nav-links{display:none;}.hero{padding:32px 16px 24px;}.hero-ghost{display:none;}.hero-title{font-size:46px;}.hero-stats{gap:24px;}.schedule-wrap{padding:16px 12px 60px;}.filter-bar{padding:10px 12px;}.show-card{grid-template-columns:72px 1fr;}.show-dur{display:none;}
}
</style>
</head>
<body>
<nav class="topnav">
  <a href="home.html" class="nav-logo">FLM<span>TV</span></a>
  <ul class="nav-links">
    <li><a href="home.html">Home</a></li>
    <li><a href="browse.html">Browse</a></li>
    <li><a href="live.html">Live TV</a></li>
    <li><a href="schedule.html" class="active">Schedule</a></li>
  </ul>
  <a href="live.html" class="live-pill"><div class="live-dot"></div> WATCH LIVE</a>
</nav>

<section class="hero">
  <div class="hero-ghost">GUIDE</div>
  <div class="hero-eyebrow"><i class="fas fa-satellite-dish"></i>&nbsp; CHANNEL 26.5 · LAS VEGAS · WORLDWIDE</div>
  <h1 class="hero-title">TODAY'S <em>PROGRAMMING</em></h1>
  <div class="hero-date" id="heroDate">—</div>
  <div class="hero-stats">
    <div><div class="stat-num" id="statTotal">—</div><div class="stat-label">Shows Today</div></div>
    <div><div class="stat-num" id="statHours">—</div><div class="stat-label">Hours</div></div>
    <div><div class="stat-num">FREE</div><div class="stat-label">Always Free</div></div>
  </div>
</section>

<div class="jump-bar">
  <button class="jump-btn" onclick="jumpToNow()">
    <div class="live-dot" style="background:var(--live-green);"></div> Jump to Now Playing
  </button>
  <button class="jump-btn" onclick="downloadSchedule()" style="border-color:rgba(201,168,76,0.4);color:var(--gold);">
    ⬇ Download Schedule
  </button>
  <div class="clock-display" id="clockDisplay">--:-- --</div>
</div>

<div class="filter-bar">
  <button class="ftab active" onclick="filterSchedule('all',this)">All</button>
  <button class="ftab" onclick="filterSchedule('shows',this)">Shows Only</button>
  <button class="ftab" onclick="filterSchedule('movies',this)">Movies</button>
  <button class="ftab" onclick="filterSchedule('kids',this)">Kids</button>
  <button class="ftab" onclick="filterSchedule('flm',this)">FLM Originals</button>
  <button class="ftab" onclick="filterSchedule('upcoming',this)">Up Next</button>
</div>

<div class="schedule-wrap" id="scheduleWrap"></div>

<div class="schedule-footer">
  Schedule is updated as programming changes &nbsp;·&nbsp;
  <strong style="color:var(--gold-dim)">FLM TV Channel 26.5</strong> &nbsp;·&nbsp;
  Las Vegas &amp; Worldwide<br>
  <a href="live.html">▶ Watch Live at FLMTV.com</a>
</div>

<script>
// ── TODAY'S SCHEDULE — Friday May 29 2026 ────────────────────────────
const TODAY_SCHEDULE = [
  {t:"07:17",n:"Snail logo1 Z",d:15,cat:""},
  {t:"07:17",n:"Sesame Street Episode 5009 (January 11, 2020)",d:1556,cat:""},
